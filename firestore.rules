rules_version = '2';

// LittleNest — strict per-tenant isolation.
//
// Two roles exist and they are not symmetrical:
//
//   • A childminder owns exactly one setting (settings/{sid}.minderUid == uid)
//     and has full access to everything beneath it.
//   • A parent has access only to the specific child documents whose
//     `parentUids` array contains their uid — never to the setting's other
//     children, never to a child list, never to invoices.
//
// Every rule below resolves the tenant from the path, so there is no way to
// read across settings even with a forged client query.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMinderOf(settingId) {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/$(settingId))
        && get(/databases/$(database)/documents/settings/$(settingId)).data.minderUid == uid();
    }

    function childDoc(settingId, childId) {
      return get(/databases/$(database)/documents/settings/$(settingId)/children/$(childId)).data;
    }

    function childExists(settingId, childId) {
      return exists(/databases/$(database)/documents/settings/$(settingId)/children/$(childId));
    }

    function isParentOf(settingId, childId) {
      return signedIn()
        && childExists(settingId, childId)
        && uid() in childDoc(settingId, childId).parentUids;
    }

    /* ── users ────────────────────────────────────────────── */
    // A user profile is private to that user. `settingId` and `role` are
    // written once at onboarding and pinned thereafter, so a parent cannot
    // promote themselves to minder by patching their own document.
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
                    && request.resource.data.role in ['minder', 'parent'];
      allow update: if signedIn() && uid() == userId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.settingId == resource.data.settingId;
      allow delete: if false;
    }

    /* ── settings ─────────────────────────────────────────── */
    match /settings/{settingId} {
      // Parents need the setting name for headers and invoices; they get read
      // only, and only once they are linked to a child inside it.
      allow read: if isMinderOf(settingId)
                  || (signedIn()
                      && exists(/databases/$(database)/documents/users/$(uid()))
                      && get(/databases/$(database)/documents/users/$(uid())).data.settingId == settingId);

      // The creator must claim themselves as the minder — you cannot mint a
      // setting owned by somebody else.
      allow create: if signedIn() && request.resource.data.minderUid == uid();
      allow update: if isMinderOf(settingId)
                    && request.resource.data.minderUid == resource.data.minderUid;
      allow delete: if isMinderOf(settingId);

      /* ── children ───────────────────────────────────────── */
      match /children/{childId} {
        allow read: if isMinderOf(settingId) || isParentOf(settingId, childId);
        allow create, delete: if isMinderOf(settingId);

        // Parents may maintain their own contact and medical details, and may
        // add themselves during invite redemption — but nothing that changes
        // money, schedule or who else can see the child.
        allow update: if isMinderOf(settingId)
          || (
            signedIn()
            && (
              isParentOf(settingId, childId)
              // Redemption: the parent is adding themselves for the first time.
              || (uid() in request.resource.data.parentUids
                  && !(uid() in resource.data.parentUids))
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'parentUids', 'parentEmails', 'parentName', 'parentPhone',
                 'emergencyName', 'emergencyPhone', 'medicalNotes'
               ])
            // A parent can only ever append themselves, never remove or add others.
            && request.resource.data.parentUids.hasAll(resource.data.parentUids)
            && request.resource.data.parentUids.hasOnly(resource.data.parentUids.concat([uid()]))
          );

        /* Daily records — the minder writes, both sides read. */
        match /entries/{entryId} {
          allow read: if isMinderOf(settingId) || isParentOf(settingId, childId);
          allow write: if isMinderOf(settingId);
        }

        match /observations/{observationId} {
          allow read: if isMinderOf(settingId) || isParentOf(settingId, childId);
          allow write: if isMinderOf(settingId);
        }

        match /attendance/{dateKey} {
          allow read: if isMinderOf(settingId) || isParentOf(settingId, childId);
          allow write: if isMinderOf(settingId);
        }

        // Overtime is a billing record: the parent may see what they are being
        // charged for, but only the minder can create or amend it.
        match /overtime/{logId} {
          allow read: if isMinderOf(settingId) || isParentOf(settingId, childId);
          allow write: if isMinderOf(settingId);
        }

        /* Messages — two-way, but each side may only write as themselves. */
        match /messages/{messageId} {
          allow read: if isMinderOf(settingId) || isParentOf(settingId, childId);

          // 'fran' is the legacy single-file app's marker for the childminder.
          // It is accepted only from an authenticated owner of this setting, so
          // it grants nothing extra — it just keeps the old GitHub Pages build
          // working during the cutover. Drop it once Pages is switched off.
          allow create: if (isMinderOf(settingId)
                            && request.resource.data.from in ['minder', 'fran'])
                        || (isParentOf(settingId, childId)
                            && request.resource.data.from == 'parent');

          // Updates exist only to flip read receipts; message text is immutable.
          allow update: if (isMinderOf(settingId) || isParentOf(settingId, childId))
                        && request.resource.data.text == resource.data.text
                        && request.resource.data.from == resource.data.from
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['readByMinder', 'readByParent']);

          allow delete: if isMinderOf(settingId);
        }
      }

      /* ── invoices ───────────────────────────────────────── */
      // Minder-only. Parents receive a PDF, not a database row.
      match /invoices/{invoiceId} {
        allow read, write: if isMinderOf(settingId);
      }
    }

    /* ── invites ──────────────────────────────────────────── */
    // Invite codes are readable by any signed-in user so a parent can validate
    // their code before an account is fully linked. The documents deliberately
    // carry nothing sensitive — a setting id, a child id and a first name — and
    // codes are 32^4 random with ambiguous glyphs removed.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;  // No enumerating the code space.

      allow create: if signedIn()
                    && isMinderOf(request.resource.data.settingId)
                    && request.resource.data.status == 'pending';

      // Redemption: a signed-in user may burn a pending code exactly once,
      // and may not repoint it at a different child or setting.
      allow update: if isMinderOf(resource.data.settingId)
                    || (signedIn()
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'used'
                        && request.resource.data.usedBy == uid()
                        && request.resource.data.settingId == resource.data.settingId
                        && request.resource.data.childId == resource.data.childId);

      allow delete: if isMinderOf(resource.data.settingId);
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
