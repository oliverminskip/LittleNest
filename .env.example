# Firebase web config.
#
# These are public client identifiers, not secrets — access is enforced by
# firestore.rules and storage.rules. They live in env vars so a staging build
# can point at a separate project without touching the code.
#
# Copy to `.env.local` for local development. CI reads them from GitHub
# repository *variables* (Settings → Secrets and variables → Actions → Variables).
VITE_FIREBASE_API_KEY=AIzaSyCPl0p0di8yTNhZVPEP5SMYeR528kiYFrw
VITE_FIREBASE_AUTH_DOMAIN=littlenest94.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=littlenest94
VITE_FIREBASE_STORAGE_BUCKET=littlenest94.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=8804693290
VITE_FIREBASE_APP_ID=1:8804693290:web:cbd50128a876a043c79a53

# Set to 1 to run the app against the local emulator suite instead of live data.
# VITE_USE_EMULATORS=1
